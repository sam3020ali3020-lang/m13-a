extern "C" JNIEXPORT jstring JNICALL

Java_com_ardophone_px4v17_bridge_PX4Bridge_nativeGetWatchdogEvents(

    JNIEnv* env, jobject, jint maxEvents) {

    // 96 kB is enough for ~200 events of 500 bytes average.  Allocated on

    // the heap (not the stack) because JNI callers may be on small threads.

    constexpr size_t kBufSize = 96 * 1024;

    char* buf = (char*)malloc(kBufSize);

    if (!buf) return env->NewStringUTF("[]");

    wd_copy_recent_events(buf, kBufSize,

                          maxEvents > 0 ? (size_t)maxEvents : 0);

    jstring out = env->NewStringUTF(buf);

    free(buf);

    return out;

}



