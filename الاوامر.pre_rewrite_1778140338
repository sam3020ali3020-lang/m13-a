#
# المتطلبات:
#   - الهاتف متصل (USB أو WiFi)
#   - التطبيق مثبّت ومُشغَّل (PX4 يعمل بعد الضغط على Start)
#   - port forwarding: adb forward tcp:5760 tcp:5760
#   - (اختياري) USB_CAN + سيرفوهات لقياس L_actuator
#   - (اختياري) HITL لتفعيل MPC وقياس L_mpc
#
# ما يُقاس:
#   L_sensor   = Phone IMU → EKF2 vehicle_attitude (دائماً قابل للقياس)
#   L_mpc      = MPC solve time (يحتاج MPC نشط — HITL أو طيران)
#   L_actuator = أمر فين → حركة سيرفو فعلية (يحتاج سيرفو + CAN)
#   L_total    = مجموع كل المراحل

# ---------- الخطوة 1: تثبيت التطبيق ----------
JAVA_HOME=/home/wd/Desktop/gab_2/Raj/m13/.local-jdk/jdk17-current \
  /home/wd/Desktop/GAB_3/123/m13/m13/AndroidApp/gradlew \
  -p /home/wd/Desktop/GAB_3/123/m13/m13/AndroidApp clean installDebug

# ---------- الخطوة 2: port forwarding (MAVLink TCP) ----------
adb forward tcp:5760 tcp:5760

# ---------- الخطوة 3: تشغيل التطبيق ----------
