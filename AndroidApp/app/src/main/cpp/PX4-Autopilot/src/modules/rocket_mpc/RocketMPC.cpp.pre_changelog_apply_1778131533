int RocketMPC::task_spawn(int argc, char *argv[])
{
	RocketMPC *instance = new RocketMPC();

	if (!instance) {
		PX4_ERR("alloc failed");
		return PX4_ERROR;
	}

	_object.store(instance);
	_task_id = task_id_is_work_queue;

	if (!instance->init()) {
		delete instance;
		_object.store(nullptr);
		_task_id = -1;
		return PX4_ERROR;
	}

	return PX4_OK;
}

int RocketMPC::custom_command(int argc, char *argv[])
{
	return print_usage("unknown command");
}

// ═══════════════════════════════════════════════════════════════════
//  Fin Mixing Self-Test
//
//  Sequence: ZERO → PITCH → ZERO → YAW → ZERO → ROLL → ZERO
//  Commands ±5° patterns through the real actuator path (xqpower_can)
//  and verifies servo feedback signs match the X-fin mixing matrix:
//
//     fin[0] = δa − δe − δr   (TR, CAN node 1)
//     fin[1] = δa − δe + δr   (BR, CAN node 2)
//     fin[2] = δa + δe + δr   (BL, CAN node 3)
//     fin[3] = δa + δe − δr   (TL, CAN node 4)
//
//  Blocked while armed.  Auto-resets RKT_MIX_TEST=0 on completion.
// ═══════════════════════════════════════════════════════════════════

void RocketMPC::_run_mixing_test()
{
	const hrt_abstime now = hrt_absolute_time();
	constexpr float  TEST_AMP_DEG = 5.0f;
	constexpr float  TEST_AMP_RAD = TEST_AMP_DEG * (float)M_PI / 180.0f;
	constexpr float  FB_SIGN_TOL  = 1.0f;   // degrees — feedback must exceed this to count
	constexpr hrt_abstime CMD_PHASE_US  = 2'000'000;  // 2 s
	constexpr hrt_abstime ZERO_PHASE_US = 1'000'000;  // 1 s

	// --- Phase transition logic ---
	auto phase_duration = [&]() -> hrt_abstime {
		switch (_mix_phase) {
		case MIX_ZERO_1: case MIX_ZERO_2:
		case MIX_ZERO_3: case MIX_ZERO_4:
			return ZERO_PHASE_US;
		case MIX_PITCH: case MIX_YAW: case MIX_ROLL:
			return CMD_PHASE_US;
		default: return 0;
		}
	};

	// Start test
	if (_mix_phase == MIX_IDLE) {
		_mix_phase = MIX_ZERO_1;
		_mix_phase_start = now;
		_mix_pass_mask = 0;
		_mix_fail_mask = 0;
		memset(_mix_fb_accum, 0, sizeof(_mix_fb_accum));
		_mix_fb_count = 0;
		mavlink_log_info(&_mavlink_log_pub, "MIX TEST: starting (12s)\t");
		PX4_INFO("MIX TEST: starting");
	}

	// Check phase timeout → advance
	hrt_abstime elapsed = now - _mix_phase_start;
	if (elapsed >= phase_duration()) {
		// Before leaving a command phase, evaluate feedback
		if (_mix_phase == MIX_PITCH || _mix_phase == MIX_YAW || _mix_phase == MIX_ROLL) {
			// Compute average feedback per servo
			float avg[4] = {0, 0, 0, 0};
			if (_mix_fb_count > 0) {
				for (int i = 0; i < 4; i++) {
					avg[i] = _mix_fb_accum[i] / (float)_mix_fb_count;
				}
			}

			// Expected sign patterns (1=positive, -1=negative)
			//                              fin0  fin1  fin2  fin3
			// PITCH (δe=+5°):  fin = -δe   -5    -5    +5    +5
			// YAW   (δr=+5°):  fin = ∓δr   -5    +5    +5    -5
			// ROLL  (δa=+5°):  fin = +δa   +5    +5    +5    +5
			int expected[4];
			const char *phase_name = "";
			uint8_t phase_bit = 0;

			if (_mix_phase == MIX_PITCH) {
				expected[0] = -1; expected[1] = -1; expected[2] = +1; expected[3] = +1;
				phase_name = "PITCH";
				phase_bit = (1 << 0);
			} else if (_mix_phase == MIX_YAW) {
				expected[0] = -1; expected[1] = +1; expected[2] = +1; expected[3] = -1;
				phase_name = "YAW";
				phase_bit = (1 << 1);
			} else { // ROLL
				expected[0] = +1; expected[1] = +1; expected[2] = +1; expected[3] = +1;
				phase_name = "ROLL";
				phase_bit = (1 << 2);
			}

			bool phase_pass = true;
			if (_mix_fb_count == 0) {
				// No feedback at all — servos not connected
				mavlink_log_warning(&_mavlink_log_pub, "MIX %s: NO FEEDBACK (servos offline?)\t", phase_name);
				phase_pass = false;
			} else {
				for (int i = 0; i < 4; i++) {
					bool sign_ok;
					if (expected[i] > 0) {
						sign_ok = (avg[i] > FB_SIGN_TOL);
					} else {
						sign_ok = (avg[i] < -FB_SIGN_TOL);
					}
					if (!sign_ok) {
						mavlink_log_warning(&_mavlink_log_pub,
							"MIX %s FAIL: fin%d avg=%.1f° (expected %s)\t",
							phase_name, i + 1, (double)avg[i],
							expected[i] > 0 ? "+" : "-");
						phase_pass = false;
					}
				}
			}

			if (phase_pass) {
				_mix_pass_mask |= phase_bit;
				PX4_INFO("MIX %s: PASS [%.1f, %.1f, %.1f, %.1f]",
					 phase_name, (double)avg[0], (double)avg[1],
					 (double)avg[2], (double)avg[3]);
			} else {
				_mix_fail_mask |= phase_bit;
			}
		}

		// Reset accumulators for next phase
		memset(_mix_fb_accum, 0, sizeof(_mix_fb_accum));
		_mix_fb_count = 0;

		// Advance to next phase
		_mix_phase = (MixTestPhase)((int)_mix_phase + 1);
		_mix_phase_start = now;

		if (_mix_phase >= MIX_DONE) {
			// --- Test complete ---
			const bool all_pass = (_mix_fail_mask == 0) && (_mix_pass_mask == 0x07);

			if (all_pass) {
				mavlink_log_info(&_mavlink_log_pub, "MIX TEST: PASS — all 3 axes correct\t");
			} else {
				mavlink_log_critical(&_mavlink_log_pub,
					"MIX TEST: FAIL — pass=0x%02X fail=0x%02X (P/Y/R)\t",
					_mix_pass_mask, _mix_fail_mask);
			}

			PX4_INFO("MIX TEST: %s (pass=0x%02X fail=0x%02X)",
				 all_pass ? "PASS" : "FAIL", _mix_pass_mask, _mix_fail_mask);

			// Auto-reset param
			_param_mix_test.set(0);
			_param_mix_test.commit_no_notification();
			_mix_phase = MIX_IDLE;

			// Send zero command to park servos
			float fin[4] = {0, 0, 0, 0};
			const bool sim_path = _hitl || (_param_sitl_gps.get() == 1);
			if (sim_path) {
				actuator_outputs_s ao{};
				ao.timestamp = now;
				ao.noutputs = 4;
				for (int i = 0; i < 4; i++) { ao.output[i] = fin[i]; }
				_actuator_outputs_sim_pub.publish(ao);
			} else {
				actuator_servos_s as{};
				as.timestamp = now;
				as.timestamp_sample = now;
				for (int i = 0; i < 4; i++) { as.control[i] = 0.0f; }
				for (int i = 4; i < actuator_servos_s::NUM_CONTROLS; i++) { as.control[i] = NAN; }
				_actuator_servos_pub.publish(as);
			}
			return;
		}
	}

	// --- Command current phase ---
	float fin_cmd_rad[4] = {0, 0, 0, 0};

	switch (_mix_phase) {
	case MIX_PITCH: {
		// Pure pitch (δe = +TEST_AMP): fin = [-δe, -δe, +δe, +δe]
		fin_cmd_rad[0] = -TEST_AMP_RAD;
		fin_cmd_rad[1] = -TEST_AMP_RAD;
		fin_cmd_rad[2] = +TEST_AMP_RAD;
		fin_cmd_rad[3] = +TEST_AMP_RAD;
		break;
	}
	case MIX_YAW: {
		// Pure yaw (δr = +TEST_AMP): fin = [-δr, +δr, +δr, -δr]
		fin_cmd_rad[0] = -TEST_AMP_RAD;
		fin_cmd_rad[1] = +TEST_AMP_RAD;
		fin_cmd_rad[2] = +TEST_AMP_RAD;
		fin_cmd_rad[3] = -TEST_AMP_RAD;
		break;
	}
	case MIX_ROLL: {
		// Pure roll (δa = +TEST_AMP): fin = [+δa, +δa, +δa, +δa]
		fin_cmd_rad[0] = +TEST_AMP_RAD;
		fin_cmd_rad[1] = +TEST_AMP_RAD;
		fin_cmd_rad[2] = +TEST_AMP_RAD;
		fin_cmd_rad[3] = +TEST_AMP_RAD;
		break;
	}
	default:
		// Zero phases — fin_cmd_rad already 0
		break;
	}

	// Publish command
	const bool sim_path = _hitl || (_param_sitl_gps.get() == 1);
	if (sim_path) {
		actuator_outputs_s ao{};
		ao.timestamp = now;
		ao.noutputs = 4;
		for (int i = 0; i < 4; i++) { ao.output[i] = fin_cmd_rad[i]; }
		_actuator_outputs_sim_pub.publish(ao);
	} else {
		const float max_d = 20.0f * (float)M_PI / 180.0f;  // XQCAN_LIMIT
		const float inv_max_d = 1.0f / max_d;
		actuator_servos_s as{};
		as.timestamp = now;
		as.timestamp_sample = now;
		for (int i = 0; i < 4; i++) {
			float n = fin_cmd_rad[i] * inv_max_d;
			if (n > 1.0f) { n = 1.0f; }
			if (n < -1.0f) { n = -1.0f; }
			as.control[i] = n;
		}
		for (int i = 4; i < actuator_servos_s::NUM_CONTROLS; i++) { as.control[i] = NAN; }
		_actuator_servos_pub.publish(as);
	}

	// Read servo feedback (only during command phases, skip first 500ms settling)
	if ((_mix_phase == MIX_PITCH || _mix_phase == MIX_YAW || _mix_phase == MIX_ROLL)
	    && elapsed > 500'000) {
		debug_array_s dbg{};
		if (_debug_array_sub.copy(&dbg)
		    && dbg.id == 1
		    && (now - dbg.timestamp) < 200'000
		    && strncmp(dbg.name, "SRV_FB", 6) == 0) {
			const uint8_t mask = (uint8_t)dbg.data[12];
			if (mask == 0x0F) {
				// data[4..7] = fin1..fin4 in degrees
				_mix_fb_accum[0] += dbg.data[4];
				_mix_fb_accum[1] += dbg.data[5];
				_mix_fb_accum[2] += dbg.data[6];
				_mix_fb_accum[3] += dbg.data[7];
				_mix_fb_count++;
			}
		}
	}
}

int RocketMPC::print_usage(const char *reason)
{
	if (reason) {
		PX4_WARN("%s\n", reason);
	}

	PRINT_MODULE_DESCRIPTION(
		R"DESCR_STR(
### Description
Rocket M130 MPC+MHE control module.
Implements acados-based MPC controller with MHE estimator and LOS guidance.
Replaces RocketGNC for optimal trajectory tracking flights.
)DESCR_STR");

	PRINT_MODULE_USAGE_NAME("rocket_mpc", "controller");
	PRINT_MODULE_USAGE_COMMAND("start");
	PRINT_MODULE_USAGE_DEFAULT_COMMANDS();

	return 0;
}

extern "C" __EXPORT int rocket_mpc_main(int argc, char *argv[])
{
	return RocketMPC::main(argc, argv);
}
