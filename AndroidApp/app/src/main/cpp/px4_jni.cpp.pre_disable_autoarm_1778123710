// =============================================================================

// Watchdog JNI surface — see watchdog_native.h

//

// Layout of the long[] returned by nativeGetModuleStatus (one row per call):

//   [ 0] alive              (0/1)

//   [ 1] was_alive_ever     (0/1)

//   [ 2] auto_restart       (0/1)

//   [ 3] last_alive_us

//   [ 4] last_tick_us

//   [ 5] last_crash_us

//   [ 6] last_restart_us

//   [ 7] last_recover_us

//   [ 8] crash_count

//   [ 9] restart_count

//   [10] stale_us

//   [11] now_us

//   [12] age_us   (UINT64_MAX clamped to Long.MAX_VALUE for JVM — see code)

// =============================================================================



static jlong clamp_u64_to_jlong(uint64_t v) {

    // jlong is signed 64-bit; UINT64_MAX overflows.  Clamp to INT64_MAX so

    // Kotlin can still treat "never alive" as a very large age_us without

    // sign-flipping into a small negative.

    const uint64_t max_signed = 0x7FFFFFFFFFFFFFFFull;

    return (jlong)(v > max_signed ? max_signed : v);

}



extern "C" JNIEXPORT jlongArray JNICALL

Java_com_ardophone_px4v17_bridge_PX4Bridge_nativeGetModuleStatus(

    JNIEnv* env, jobject, jstring jname) {



    const char* name = jname ? env->GetStringUTFChars(jname, nullptr) : nullptr;

    wd_status_t st{};

    const bool ok = name ? wd_get_module_status(name, &st) : false;

    if (jname && name) env->ReleaseStringUTFChars(jname, name);



    if (!ok) {

        // Return empty array to signal "unknown module / watchdog not running"

        return env->NewLongArray(0);

    }



    jlongArray out = env->NewLongArray(13);

    jlong vals[13] = {

        st.alive           ? 1 : 0,

        st.was_alive_ever  ? 1 : 0,

        st.auto_restart    ? 1 : 0,

        (jlong)st.last_alive_us,

        (jlong)st.last_tick_us,

        (jlong)st.last_crash_us,

        (jlong)st.last_restart_us,

        (jlong)st.last_recover_us,

        (jlong)st.crash_count,

        (jlong)st.restart_count,

        (jlong)st.stale_us,

        (jlong)st.now_us,

        clamp_u64_to_jlong(st.age_us),

    };

    env->SetLongArrayRegion(out, 0, 13, vals);

    return out;

}



extern "C" JNIEXPORT jobjectArray JNICALL

Java_com_ardophone_px4v17_bridge_PX4Bridge_nativeListWatchdogModules(

    JNIEnv* env, jobject) {



    const char* names[32] = {nullptr};

    const size_t n = wd_list_modules(names, 32);



    jclass string_cls = env->FindClass("java/lang/String");

    jobjectArray out = env->NewObjectArray((jsize)n, string_cls, nullptr);

    for (size_t i = 0; i < n; ++i) {

        env->SetObjectArrayElement(out, (jsize)i, env->NewStringUTF(names[i]));

    }

    return out;

}



